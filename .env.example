# API
MONGODB_URI=mongodb://localhost:27017/interview-prep
JWT_SECRET=dev-secret-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
PORT=4000
NODE_ENV=development

# LLM Provider
# Set LLM_PROVIDER to either:
#   gemini          — Google Gemini (genuine free tier: 15 RPM / 1M TPM / 1500 RPD on gemini-1.5-flash)
#   openai-compat   — Any OpenAI-compatible REST API (OpenAI, Groq, Together, etc.)
LLM_PROVIDER=gemini

# API key for the chosen provider
LLM_API_KEY=

# Model identifier (must match the provider's model name)
# Gemini free-tier default: gemini-1.5-flash
# OpenAI free-tier alternative: gpt-3.5-turbo
LLM_MODEL=gemini-1.5-flash

# Generation temperature (0 = deterministic, good for structured extraction)
LLM_TEMPERATURE=0

# Base URL for OpenAI-compatible providers (ignored when LLM_PROVIDER=gemini)
LLM_BASE_URL=https://api.openai.com/v1

# Max concurrent LLM calls (tune to stay within free-tier RPM limits)
# Gemini free tier: 15 RPM → concurrency of 3 with ~12 s average call time is safe
LLM_CONCURRENCY=3

# Retry settings (exponential back-off with jitter)
LLM_MAX_RETRIES=4
LLM_RETRY_BASE_MS=500

# Search API for research (SerpAPI, Tavily, Brave, etc.)
SEARCH_API_KEY=
SEARCH_ENGINE=serpapi

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000