# API & Database
MONGODB_URI=mongodb://localhost:27017/interview-prep
PORT=4000
NODE_ENV=development

# Authentication & Session Security (Must change in production)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
SESSION_SECRET=replace-with-a-random-session-secret-at-least-32-characters
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
CSRF_ENABLED=true

# LLM Provider
# Set LLM_PROVIDER to either:
#   gemini          — Google Gemini API
#   openai-compat   — Any OpenAI-compatible REST API (OpenAI, Groq, Together, etc.)
LLM_PROVIDER=gemini

# API key for the chosen provider
LLM_API_KEY=

# Model identifier (must match the provider's model name)
# Set a model ID that is available to your provider account.
LLM_MODEL=gemini-1.5-flash

# Generation temperature (0 = deterministic, good for structured extraction)
LLM_TEMPERATURE=0

# Base URL for OpenAI-compatible providers (ignored when LLM_PROVIDER=gemini)
LLM_BASE_URL=https://api.openai.com/v1

# Maximum concurrent LLM calls; tune for your provider's limits.
LLM_CONCURRENCY=3

# Retry settings (exponential back-off with jitter)
LLM_MAX_RETRIES=4
LLM_RETRY_BASE_MS=500

# Optional search-provider configuration; not used by the default pipeline.
SEARCH_API_KEY=
SEARCH_ENGINE=serpapi

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
